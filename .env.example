# ============================================
# reels-to-email — Environment template
# ============================================
# 1. Copy this file to `.env` (NOT renamed, just `.env`)
# 2. Fill in real values
# 3. NEVER commit .env — it's git-ignored
# ============================================


# --- Telegram Bot ---
# Get this from @BotFather on Telegram after /newbot
TELEGRAM_BOT_TOKEN=PASTE_HERE


# --- Resend (email sending) ---
# API key from https://resend.com/api-keys
RESEND_API_KEY=PASTE_HERE
# Sender address. Default works for sending to yourself.
# For sending to others, verify your own domain at resend.com/domains.
RESEND_FROM_EMAIL=onboarding@resend.dev


# --- OpenAI / Whisper (transcription) ---
# API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=PASTE_HERE


# --- Anthropic / Claude (explanation + tagging) ---
# API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=PASTE_HERE


# --- Perplexity (web research) ---
# API key from https://perplexity.ai/settings/api
# Note: Perplexity Pro subscription does NOT include API credit — separate.
PERPLEXITY_API_KEY=PASTE_HERE


# --- Email destination ---
# The email address where the final processed emails will arrive
TARGET_EMAIL=PASTE_YOUR_EMAIL_HERE
